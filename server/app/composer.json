{
    "name": "schorsch3000/linkrot-server",
    "description": "Linkrot server: expiring file sharing links",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.4",
        "ext-apcu": "*",
        "ext-ctype": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-random": "*",
        "bacon/bacon-qr-code": "^3.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "Linkrot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Linkrot\\Tests\\": "../tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
