{
    "name": "schorsch3000/linkrot-server",
    "description": "Linkrot server: expiring file sharing links",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-random": "*",
        "ext-xmlwriter": "*",
        "bacon/bacon-qr-code": "^3.1",
        "league/commonmark": "^2.7"
    },
    "suggest": {
        "ext-apcu": "keeps the counters of failed logins in memory; without it they are in ratelimit.sqlite of the host"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Linkrot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Linkrot\\Tests\\": "../tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
