#!/usr/bin/env php
<?php

declare(strict_types=1);

use Linkrot\Auth\TokenStore;
use Linkrot\Cli\AuthCommand;
use Linkrot\Database;
use Linkrot\SchemaOutdatedException;

require __DIR__ . '/../vendor/autoload.php';

$dataDir = getenv('LINKROT_DATA') ?: __DIR__ . '/../../app_data';
if (!is_dir($dataDir)) {
    fwrite(STDERR, "lr-auth: data directory not found: $dataDir\n");
    exit(AuthCommand::FAILED);
}

try {
    $pdo = Database::openCurrent($dataDir . '/linkrot.sqlite');
} catch (SchemaOutdatedException $e) {
    fwrite(STDERR, 'lr-auth: ' . $e->getMessage() . "\n");
    exit(AuthCommand::FAILED);
}

$command = new AuthCommand(new TokenStore($pdo), STDOUT, STDERR);
exit($command->run(array_slice($argv, 1)));
