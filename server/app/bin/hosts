#!/usr/bin/env php
<?php

declare(strict_types=1);

use Linkrot\Cli\HostsCommand;

require __DIR__ . '/../vendor/autoload.php';

/*
 * hosts                                  prints the hosts of global-config.php, one per line
 * hosts add <host> [--email <address>]   enrolls a host: global-config.php, its folders, a default config.php
 * hosts rewrite [<host>]                 writes config.php again from its values, defaults as comments
 * data directory: $LINKROT_DATA or ../../app_data
 */
exit(new HostsCommand(getenv('LINKROT_DATA') ?: __DIR__ . '/../../app_data', STDOUT, STDERR)->run(array_slice($argv, 1)));
