# linkrot for shared hosting: every request that is not a file goes to index.php, and PHP gets to see the
# Authorization header (Apache drops it when PHP runs as CGI or FastCGI). Made for Apache and LiteSpeed; the setup
# (setup.php) checks that it works.

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    # the probes of the setup take the same way as the API
    RewriteRule ^linkrot-setup-probe$ setup.php [QSA,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# PHP runs these and they print nothing; they are not for the web anyway
<FilesMatch "^(setup-code|linkrot-paths)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
